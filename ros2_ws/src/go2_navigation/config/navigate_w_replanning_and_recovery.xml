<!--
  Replan at 2 Hz. Wait briefly on failure instead of clearing a real obstacle
  out of the costmap. Keep the goal through up to 10 recovery waits
  so a person crossing/occupying the goal briefly does not abandon navigation.
  Persistent failures still terminate; cancel and new goals remain interruptible.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="10" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="2.0">
          <Sequence>
            <LatestGoalPose input="{goal}" output="{planning_goal}"/>
            <ComputePathToPose server_timeout="1000" goal="{planning_goal}" path="{path}" planner_id="GridBased"/>
          </Sequence>
        </RateController>
        <FollowPath server_timeout="1000" path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <!-- Humble stores wait duration in integer seconds; 0.25 became zero. -->
        <Wait wait_duration="1"/>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
