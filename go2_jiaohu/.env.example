# 复制为 .env 或在启动前 export；所有 AI 推理均在本机完成，无需 API Key。
GO2_NETWORK_INTERFACE=eth0
# Livox HAP driver underlay and the dedicated HAP Ethernet connection.
LIVOX_WS=/home/fishbone/GO2/livox_ws
HAP_NETWORK_INTERFACE=enx00e04c3c2370
HAP_IP=192.168.1.100
# auto: 优先 RealSense 彩色流，失败时回退 Go2 组播；也可填 go2 或 local。
GO2_UI_CAMERA_SOURCE=auto
ROS_DOMAIN_ID=0
# Jetson/PulseAudio 推荐填 pulse；可按设备列表改为其他 PyAudio 名称或索引。
GO2_VOICE_INPUT_DEVICE=pulse
# 可选：将 PulseAudio 精确锁定到现场 USB 输入/输出名称。
GO2_AUDIO_ALSA_CARD=
GO2_AUDIO_PULSE_CARD=
GO2_AUDIO_PULSE_PROFILE=output:analog-stereo+input:mono-fallback
GO2_AUDIO_AGC=off
GO2_AUDIO_MIC_GAIN=80%
# 可选：USB 声卡的独立硬件播放控件，例如 XVF3800 使用 PCM,1。
GO2_AUDIO_PLAYBACK_CONTROL=
GO2_AUDIO_PLAYBACK_VOLUME=100%
GO2_AUDIO_OUTPUT_VOLUME=125%
PULSE_SOURCE=
PULSE_SINK=
GO2_ROBOT_NAME=邦邦
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=30
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_CHAT_MAX_PREDICT=64
OLLAMA_HISTORY_MESSAGES=4
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP=1
# 画面描述 / OCR / 文字追问使用独立视觉模型。
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
# Uses the existing measured HAP-D435i calibration plus live lidar-to-base TF.
GO2_VISUAL_CAMERA_FRAME=camera_color_optical_frame
GO2_VISUAL_CAMERA_CALIBRATION=config/visual_camera_calibration.json
# Optional x,y,z,roll,pitch,yaw (metres/degrees); leave empty until measured.
GO2_VISUAL_CAMERA_MOUNT=
# Optional override of the bundled local YOLOv8n checkpoint (no auto-download).
# GO2_PERSON_DETECTOR_MODEL=/absolute/path/to/yolov8n.pt
# small 作为低延迟 GPU 主模型；疑难语音自动交给 large-v3-turbo。
WHISPER_MODEL=voice/models/faster-whisper-small
WHISPER_CPU_FALLBACK_MODEL=voice/models/faster-whisper-small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LOCAL_FILES_ONLY=1
WHISPER_MIN_AVG_LOGPROB=-0.65
WHISPER_MAX_NO_SPEECH_PROB=0.70
WHISPER_SUSPICIOUS_MIN_AVG_LOGPROB=-0.35
WHISPER_BEAM_SIZE=2
WHISPER_BEST_OF=2
WHISPER_CHUNK_LENGTH=10
WHISPER_MAX_NEW_TOKENS=96
WHISPER_HOTWORDS=""
# 可选二级复核模型：仅在 small 置信度不足时懒加载更快的 large-v3-turbo。
WHISPER_RESCUE_MODEL=voice/models/faster-whisper-large-v3-turbo
WHISPER_PRELOAD_RESCUE=0
WHISPER_RESCUE_BEAM_SIZE=5
WHISPER_RESCUE_BEST_OF=5
WHISPER_RESCUE_MIN_AVG_LOGPROB=-0.45
WHISPER_RESCUE_MIN_LANGUAGE_PROB=0.45
WHISPER_RESCUE_MAX_NO_SPEECH_PROB=0.45
WHISPER_RESCUE_ACCEPT_MIN_AVG_LOGPROB=-0.45
WHISPER_RESCUE_ACCEPT_MAX_NO_SPEECH_PROB=0.45
WHISPER_RESCUE_LANGUAGE_LOCK_PROB=0.80
WHISPER_RESCUE_VOCABULARY=config/asr_vocabulary.json
WHISPER_COMMAND_RESCUE_MIN_AVG_LOGPROB=-0.35
WHISPER_COMMAND_RESCUE_MAX_NO_SPEECH_PROB=0.25
WHISPER_COMMAND_RESCUE_MIN_LANGUAGE_PROB=0.60
GO2_MIC_MIN_ENERGY=200
GO2_MIC_MAX_ENERGY=450
GO2_MIC_PHRASE_THRESHOLD=0.45
GO2_MIC_PAUSE_THRESHOLD=0.45
GO2_MIC_NON_SPEAKING_DURATION=0.25
# Kokoro 本地 GPU 男声（zm_yunxi）；模型目录需包含 config.json、权重和 voices/。
GO2_TTS_MODEL_DIR=voice/models/kokoro-pytorch
GO2_TTS_VOICE=zm_yunxi
GO2_TTS_SPEED=1.04
GO2_TTS_VOLUME=3.0
GO2_TTS_ECHO_COOLDOWN_SECONDS=0.25
GO2_OBSTACLE_STOP_DISTANCE_M=0.60
GO2_VISUAL_GUIDE_TIMEOUT=120
# sdk（默认）通过隔离的 unitree_sdk2_python 进程直连；ros 为兼容后端。
GO2_MOTION_BACKEND=sdk
GO2_SDK_RPC_TIMEOUT=2.0
GO2_SDK_VERIFY_SERVER=1
GO2_SDK_MOVE_INTERVAL=0.05
GO2_INTERACTIVE_COMMAND_TOPIC=/go2/interactive_command
GO2_INTERACTIVE_STATUS_TOPIC=/go2/interactive_status
GO2_COMMAND_ACK_TIMEOUT=2.0
GO2_DEFAULT_LINEAR_SPEED=0.30
GO2_DEFAULT_TURN_SPEED=0.50
GO2_STEP_LENGTH_M=0.40
GO2_LINEAR_TIME_MULTIPLIER=1.30
GO2_TURN_TIME_MULTIPLIER=2.00
# 可选现场报警程序（不经过 shell）；报警 JSON 会放在 BANGBANG_ALARM_EVENT 环境变量。
BANGBANG_ALARM_COMMAND=
BANGBANG_ALARM_ROS_TOPIC=/bangbang/emergency_alert
